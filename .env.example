# =====================================================================
# JORNADA DA LIBERDADE — Configuração de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais.
# O arquivo .env NUNCA deve ser versionado (está no .gitignore).
# =====================================================================

# ---------------------------------------------------------------
# Banco de dados (PostgreSQL)
# Formato: postgresql://usuario:senha@host:porta/banco?schema=nome
# ---------------------------------------------------------------
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?schema=jornadaliberdade

# ---------------------------------------------------------------
# Salário mínimo vigente
# Usado para calcular as metas de renda passiva em salários mínimos (SM).
# Formato: valor em reais com PONTO decimal e sempre 2 casas para os centavos
# (não use vírgula nem separador de milhar).
# Exemplos: 1621.00 = R$ 1.621,00 | 1518.50 = R$ 1.518,50 | 1412.00 = R$ 1.412,00
# Atualize este valor manualmente sempre que o salário mínimo nacional mudar
# (normalmente todo mês de janeiro).
# ---------------------------------------------------------------
MINIMUM_WAGE=1621.00

# ---------------------------------------------------------------
# Segredo JWT
# Gere um valor seguro com: openssl rand -base64 32
# ---------------------------------------------------------------
JWT_SECRET=troque-por-uma-chave-secreta-forte

# ---------------------------------------------------------------
# Login com Google — único método de autenticação do app
# Crie em https://console.cloud.google.com/apis/credentials
# (Create Credentials > OAuth client ID > Web application),
# com o domínio do frontend em "Authorized JavaScript origins"
# (ex: http://localhost:5173 em dev, seu domínio em produção)
# ---------------------------------------------------------------
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# ---------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------
NODE_ENV=production

# ---------------------------------------------------------------
# Portas
# ---------------------------------------------------------------
BACKEND_PORT=3001
FRONTEND_PORT=5173

# ---------------------------------------------------------------
# CORS — origens permitidas para acessar a API
# Separe múltiplos domínios por vírgula.
# Em dev local, use: http://localhost:5173
# ---------------------------------------------------------------
CORS_ORIGIN=https://seu-dominio.com

# ---------------------------------------------------------------
# Hosts permitidos pelo servidor Vite (frontend)
# Separe múltiplos hosts por vírgula (sem protocolo).
# Em dev local, deixe vazio ou use: localhost
# ---------------------------------------------------------------
FRONTEND_ALLOWED_HOSTS=seu-dominio.com

# ---------------------------------------------------------------
# Caminhos de contexto de build (padrão: subpastas do projeto)
# ---------------------------------------------------------------
BACKEND_PATH=./backend
FRONTEND_PATH=./frontend
