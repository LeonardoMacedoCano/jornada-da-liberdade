# =====================================================================
# JORNADA DA LIBERDADE — Configuração de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais.
# O arquivo .env NUNCA deve ser versionado (está no .gitignore).
# =====================================================================

# ---------------------------------------------------------------
# Banco de dados (PostgreSQL)
# Formato: postgresql://usuario:senha@host:porta/banco?schema=nome
# ---------------------------------------------------------------
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?schema=jornadaliberdade

# ---------------------------------------------------------------
# Segredo JWT
# Gere um valor seguro com: openssl rand -base64 32
# ---------------------------------------------------------------
JWT_SECRET=troque-por-uma-chave-secreta-forte

# ---------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------
NODE_ENV=production

# ---------------------------------------------------------------
# Portas
# ---------------------------------------------------------------
BACKEND_PORT=3001
FRONTEND_PORT=5173

# ---------------------------------------------------------------
# CORS — origens permitidas para acessar a API
# Separe múltiplos domínios por vírgula.
# Em dev local, use: http://localhost:5173
# ---------------------------------------------------------------
CORS_ORIGIN=https://seu-dominio.com

# ---------------------------------------------------------------
# Hosts permitidos pelo servidor Vite (frontend)
# Separe múltiplos hosts por vírgula (sem protocolo).
# Em dev local, deixe vazio ou use: localhost
# ---------------------------------------------------------------
FRONTEND_ALLOWED_HOSTS=seu-dominio.com

# ---------------------------------------------------------------
# Caminhos de contexto de build (padrão: subpastas do projeto)
# ---------------------------------------------------------------
BACKEND_PATH=./backend
FRONTEND_PATH=./frontend
